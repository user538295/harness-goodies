{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-c",
              "import os,subprocess,sys; p=sys.argv[1]; os.path.isfile(p) and subprocess.call([sys.executable,p]+sys.argv[2:])",
              "${CLAUDE_PLUGIN_ROOT}/skills/session-log/session_log.py",
              "hook",
              "claude",
              "SessionStart"
            ],
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
