#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

readonly SUPPORTED_HARNESSES="claude, codex, cursor, opencode, omp"
readonly OWNER_MARKER_VALUE="universal-session-log"
# What makes Codex run hooks.json commands it has not run yet: trusting them in /hooks reloads the
# running session's hooks, and a restart shows the "Hooks need review" screen while any hook is new
# or changed. RESTORE_FOLLOW_UP in adapters/native/install_hooks.py says the same (tests check it).
readonly CODEX_TRUST_INSTRUCTION="approve the session-log hooks in /hooks, or restart Codex and choose 'Trust all and continue' if it shows the 'Hooks need review' screen"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
PACKAGE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
readonly PACKAGE_ROOT
VERSION="$(tr -d '[:space:]' < "$PACKAGE_ROOT/VERSION")"
readonly VERSION
HOME_ROOT="$(cd "${HOME:?HOME is required}" && pwd -P)"
readonly HOME_ROOT
readonly STORE="$HOME_ROOT/.local/share/universal-session-log"
# No hook of this package's version has seen the flag in the running Cursor: the cursor-goodies
# plugin is missing or predates its hooks, Cursor still runs the hooks of an older plugin version
# (the runtime marker must carry this VERSION), Cursor loads plugin hooks only while this setting is
# on (and its server-side plugin import gate allows it), or Cursor has not restarted since.
readonly CURSOR_HOOKS_NOT_LOADED="on — no hook of this cursor-goodies version has run; install or update the plugin, check that Include Third-Party Plugins, Skills, and Other Configs is on in Cursor Settings, then restart Cursor"
# Cursor's first `on`: the flag exists, but only a hook run proves the plugin hooks are loaded.
readonly CURSOR_ON_UNTIL_HOOKS_RUN="on — logging starts with the next prompt once the cursor-goodies hooks run; run status after it to confirm"
HARNESS=""
ENTRYPOINT=""
COMMAND="status"
declare -a COMMAND_ARGS=()
RAW_ARGUMENTS=""
RAW_ARGUMENTS_SET=0
DIRECT_COMMAND_SET=0
HARNESS_LABEL=""
HARNESS_ROOT=""
STATE_DIR=""
FLAG_FILE=""
RUNTIME_FILE=""
ENABLE_LOCK=""
INSTALL_LOCK=""
INSTALL_LOCK_OWNER_START=""
REPAIR_REPORTED=0

SESSION_LOG_LOG_PREFIX="session-log"
# shellcheck source=../lib/common.sh
source "$PACKAGE_ROOT/lib/common.sh"
# shellcheck source=../lib/adapter_install.sh
source "$PACKAGE_ROOT/lib/adapter_install.sh"
# shellcheck source=../lib/legacy_cleanup.sh
source "$PACKAGE_ROOT/lib/legacy_cleanup.sh"

declare -rA HARNESS_LABELS=(
  [claude]="Claude Code" [codex]="Codex" [cursor]="Cursor" [opencode]="OpenCode" [omp]="OMP"
)
declare -rA HARNESS_SUBROOTS=(
  [claude]=".claude" [codex]=".codex" [cursor]=".cursor"
  [opencode]=".config/opencode" [omp]=".omp/agent"
)
declare -rA ADAPTER_SOURCES=(
  [opencode:usage]="adapters/opencode/session_log_usage.sh"
  [omp:extension]="adapters/omp/session-log.js"
  [omp:usage]="adapters/omp/session_log_usage.ts"
  [cursor:configurator]="adapters/native/install_hooks.py"
  [codex:configurator]="adapters/native/install_hooks.py"
  [codex:usage]="adapters/codex/session_log_usage.py"
  [cursor:usage]="adapters/cursor/session_log_usage.py"
)

split_command_string() {
  local input="$1" char state="plain" token="" token_started=0 escaped=0 i
  local -a tokens=()
  for ((i = 0; i < ${#input}; i++)); do
    char="${input:i:1}"
    case "$state" in
      plain)
        if ((escaped)); then
          token+="$char"
          escaped=0
          token_started=1
        elif [[ "$char" == "\\" ]]; then
          escaped=1
          token_started=1
        elif [[ "$char" == "'" ]]; then
          state="single"
          token_started=1
        elif [[ "$char" == '"' ]]; then
          state="double"
          token_started=1
        elif [[ "$char" == " " || "$char" == $'\t' || "$char" == $'\n' ]]; then
          if ((token_started)); then
            tokens+=("$token")
            token=""
            token_started=0
          fi
        else
          token+="$char"
          token_started=1
        fi
        ;;
      single)
        if [[ "$char" == "'" ]]; then
          state="plain"
        else
          token+="$char"
        fi
        ;;
      double)
        if ((escaped)); then
          if [[ "$char" == '$' || "$char" == '`' || "$char" == '"' || "$char" == "\\" ]]; then
            token+="$char"
          elif [[ "$char" != $'\n' ]]; then
            token+="\\$char"
          fi
          escaped=0
        elif [[ "$char" == "\\" ]]; then
          escaped=1
        elif [[ "$char" == '"' ]]; then
          state="plain"
        else
          token+="$char"
        fi
        ;;
    esac
  done
  ((escaped == 0)) || fail "unterminated escape in command arguments"
  [[ "$state" == plain ]] || fail "unterminated quote in command arguments"
  if ((token_started)); then tokens+=("$token"); fi
  ((${#tokens[@]} > 0)) || fail "session-log command is required"
  case "${tokens[0]}" in
    on|off|status|usage|repair) ;;
    *) fail "unknown command: ${tokens[0]}" ;;
  esac
  COMMAND="${tokens[0]}"
  COMMAND_ARGS=("${tokens[@]:1}")
}

validate_command_args() {
  case "$COMMAND" in
    on|off|status|repair)
      ((${#COMMAND_ARGS[@]} == 0)) ||
        fail "trailing arguments are not valid for $COMMAND"
      ;;
  esac
}

parse_args() {
  local arg
  while (($#)); do
    arg="$1"
    case "$arg" in
      --entrypoint)
        [[ -z "$ENTRYPOINT" ]] || fail "conflicting native entrypoint claims"
        (($# >= 2)) || fail "--entrypoint requires a value"
        ENTRYPOINT="$2"
        shift 2
        ;;
      --entrypoint=*)
        [[ -z "$ENTRYPOINT" ]] || fail "conflicting native entrypoint claims"
        ENTRYPOINT="${arg#*=}"
        [[ -n "$ENTRYPOINT" ]] || fail "--entrypoint requires a value"
        shift
        ;;
      --harness)
        [[ -z "$HARNESS" ]] || fail "conflicting harness identity claims"
        (($# >= 2)) || fail "--harness requires a value"
        HARNESS="$2"
        shift 2
        ;;
      --harness=*)
        [[ -z "$HARNESS" ]] || fail "conflicting harness identity claims"
        HARNESS="${arg#*=}"
        [[ -n "$HARNESS" ]] || fail "--harness requires a value"
        shift
        ;;
      --arguments)
        [[ "$RAW_ARGUMENTS_SET" == 0 ]] || fail "only one command argument string is allowed"
        (($# >= 2)) || fail "--arguments requires a value"
        RAW_ARGUMENTS="$2"
        RAW_ARGUMENTS_SET=1
        shift 2
        ;;
      --arguments=*)
        [[ "$RAW_ARGUMENTS_SET" == 0 ]] || fail "only one command argument string is allowed"
        RAW_ARGUMENTS="${arg#*=}"
        RAW_ARGUMENTS_SET=1
        shift
        ;;
      on|off|status|usage|repair)
        [[ "$DIRECT_COMMAND_SET" == 0 ]] || fail "only one session-log command is allowed"
        [[ "$RAW_ARGUMENTS_SET" == 0 ]] || fail "cannot combine a command with --arguments"
        DIRECT_COMMAND_SET=1
        COMMAND="$1"
        shift
        while (($#)); do
          COMMAND_ARGS+=("$1")
          shift
        done
        ;;
      --help|-h)
        printf 'Usage: session-log --entrypoint <claude|codex|cursor|opencode|omp> --harness <same> [on|off|status|usage|repair] [native args...]\n'
        printf '       session-log --entrypoint <claude|codex|cursor|opencode|omp> --harness <same> --arguments "<command and native args>"\n'
        exit 0
        ;;
      --)
        shift
        (($#)) && fail "unexpected argument: $1"
        ;;
      *)
        fail "unknown argument: $arg"
        ;;
    esac
  done

  if ((RAW_ARGUMENTS_SET)); then
    ((DIRECT_COMMAND_SET == 0)) || fail "cannot combine a command with --arguments"
    split_command_string "$RAW_ARGUMENTS"
  fi
  validate_command_args
  [[ -n "$ENTRYPOINT" ]] || fail "active harness identity is required from a native entrypoint"
  [[ -n "$HARNESS" ]] || fail "active harness identity is required from a native entrypoint"
  [[ "$ENTRYPOINT" == "$HARNESS" ]] || fail "conflicting native entrypoint and harness identities"
  case "$HARNESS" in
    claude|codex|cursor|opencode|omp) ;;
    *) fail "unsupported harness '$HARNESS'; supported harnesses: $SUPPORTED_HARNESSES" ;;
  esac
}

resolve_roots() {
  guard_relocated_root
  HARNESS_LABEL="${HARNESS_LABELS[$HARNESS]}"
  HARNESS_ROOT="$HOME_ROOT/${HARNESS_SUBROOTS[$HARNESS]}"
  STATE_DIR="$HARNESS_ROOT/session-log"
  FLAG_FILE="$HARNESS_ROOT/prompt-logs/.enabled"
  RUNTIME_FILE="$STATE_DIR/runtime.json"
  ENABLE_LOCK="$FLAG_FILE.lock"
  INSTALL_LOCK="$STATE_DIR/.install.lock"
}

guard_relocated_root() {
  local relocated="root is relocated; install this package explicitly for that location"
  case "$HARNESS" in
    claude) guard_env CLAUDE_CONFIG_DIR "$HOME_ROOT/.claude" "Claude Code $relocated" ;;
    codex) guard_env CODEX_HOME "$HOME_ROOT/.codex" "Codex $relocated" ;;
    opencode)
      guard_env OPENCODE_CONFIG_DIR "$HOME_ROOT/.config/opencode" "OpenCode $relocated"
      guard_env XDG_CONFIG_HOME "$HOME_ROOT/.config" "OpenCode $relocated"
      guard_env XDG_DATA_HOME "$HOME_ROOT/.local/share" "OpenCode data $relocated"
      ;;
    omp)
      # The omp plugin has no install step to point elsewhere, so only the default root works.
      guard_env PI_CODING_AGENT_DIR "$HOME_ROOT/.omp/agent" "OMP root is relocated; session-log supports only ~/.omp/agent"
      guard_env OMP_PROMPT_LOG_DIR "$HOME_ROOT/.omp/agent/prompt-logs" \
        "OMP prompt-log root is relocated; session-log supports only ~/.omp/agent/prompt-logs"
      ;;
  esac
}

source_for() {
  local relative="${ADAPTER_SOURCES[$HARNESS:$1]:-}"
  [[ -n "$relative" ]] || fail "no adapter asset for $HARNESS/$1"
  printf '%s\n' "$PACKAGE_ROOT/$relative"
}

# True when the hooks of a running session have written their runtime marker, for this VERSION.
runtime_current() {
  validate_state_dir
  require_command jq
  local candidate loaded_at now pid expected_start actual_start
  local -a candidates=("$RUNTIME_FILE" "$STATE_DIR"/runtime.*.json)
  for candidate in "${candidates[@]}"; do
    [[ -f "$candidate" && ! -L "$candidate" ]] || continue
    [[ "$(jq -r '.harness // empty' "$candidate" 2>/dev/null)" == "$HARNESS" ]] || continue
    [[ "$(jq -r '.version // empty' "$candidate" 2>/dev/null)" == "$VERSION" ]] || continue
    if [[ "$HARNESS" == claude ]]; then
      [[ -n "$(jq -r '.session_id // empty' "$candidate" 2>/dev/null)" ]] || continue
      [[ "$(jq -r '.loaded_at // empty' "$candidate" 2>/dev/null)" =~ ^[0-9]+$ ]] || continue
      loaded_at="$(jq -r '.loaded_at' "$candidate" 2>/dev/null)"
      now="$(date +%s)"
      ((loaded_at <= now)) || continue
    fi
    pid="$(jq -r '.pid // empty' "$candidate" 2>/dev/null)"
    expected_start="$(jq -r '.process_start // empty' "$candidate" 2>/dev/null | sed 's/[[:space:]]*$//')"
    [[ "$pid" =~ ^[1-9][0-9]*$ && -n "$expected_start" ]] || continue
    kill -0 "$pid" 2>/dev/null || continue
    actual_start="$(ps -p "$pid" -o lstart= 2>/dev/null | sed 's/^ *//; s/[[:space:]]*$//')"
    [[ -n "$actual_start" && "$actual_start" == "$expected_start" ]] || continue
    [[ -n "$(jq -r '.nonce // empty' "$candidate" 2>/dev/null)" ]] || continue
    return 0
  done
  return 1
}

set_enable_state_locked() {
  local action="$1"
  SESSION_LOG_ENABLE_LOCK="$ENABLE_LOCK" \
    SESSION_LOG_ENABLE_FLAG="$FLAG_FILE" \
    SESSION_LOG_ENABLE_ACTION="$action" \
    python3 "$SESSION_LOG_LIB/enable_flag.py"
}

set_enabled() {
  ensure_safe_parent "$FLAG_FILE"
  [[ ! -L "$FLAG_FILE" ]] && [[ ! -d "$FLAG_FILE" ]] ||
    fail "refusing to overwrite symlinked or directory enable flag: $FLAG_FILE"
  ensure_private_directory "$(dirname "$FLAG_FILE")"
  set_enable_state_locked on
}

set_disabled() {
  ensure_safe_parent "$FLAG_FILE"
  [[ ! -L "$FLAG_FILE" ]] || fail "refusing to remove symlinked enable flag: $FLAG_FILE"
  if [[ -e "$FLAG_FILE" ]]; then
    ensure_private_directory "$(dirname "$FLAG_FILE")"
    set_enable_state_locked off
  fi
  # A loaded extension stays loaded after `off`, so its marker stays too.
  runtime_marks_load || clear_runtime_markers
}

# True when the harness plugin registers the session-log hooks from its own package. Its hooks
# log nothing until the enable flag exists (omp's extension still writes its load marker and may
# start the legacy cleanup when it loads), so `on` runs the legacy cleanup and sets that flag, `off`
# removes it and clears the runtime markers (except omp's), and nothing installs, compares, or
# reinstalls an adapter. A harness whose plugin takes over its hooks joins here; the leftovers of
# its older releases go in its legacy_cleanup_<harness> (lib/legacy_cleanup.sh).
plugin_owns_hooks() {
  [[ "$HARNESS" == claude || "$HARNESS" == cursor || "$HARNESS" == omp || "$HARNESS" == opencode ]]
}

# True when the runtime marker means "the extension is loaded" rather than "the hooks saw the flag":
# omp's extension writes it when it loads, logging on or off, and reads the flag at every prompt.
runtime_marks_load() {
  [[ "$HARNESS" == omp ]]
}

print_status() {
  ensure_safe_parent "$FLAG_FILE"
  [[ ! -L "$FLAG_FILE" ]] || fail "refusing to follow symlinked enable flag: $FLAG_FILE"
  [[ ! -d "$FLAG_FILE" ]] || fail "refusing to read enable directory: $FLAG_FILE"
  if [[ ! -e "$FLAG_FILE" ]]; then
    printf '%s: off\n' "$HARNESS_LABEL"
    return
  fi
  if [[ "$HARNESS" == codex ]] && ! codex_plugin_package_present; then
    printf '%s: on — codex-goodies plugin not installed\n' "$HARNESS_LABEL"
    return
  fi
  if ! plugin_owns_hooks && ! adapter_current; then
    printf '%s: on — adapter missing\n' "$HARNESS_LABEL"
    return
  fi
  if ! runtime_current; then
    if [[ "$HARNESS" == codex ]]; then
      printf '%s: on — %s\n' "$HARNESS_LABEL" "$CODEX_TRUST_INSTRUCTION"
    elif [[ "$HARNESS" == cursor ]]; then
      printf '%s: %s\n' "$HARNESS_LABEL" "$CURSOR_HOOKS_NOT_LOADED"
    else
      printf '%s: on — restart required\n' "$HARNESS_LABEL"
    fi
    return
  fi
  printf '%s: on\n' "$HARNESS_LABEL"
}
validate_usage_args() {
  local arg target_count=0
  for arg in "${COMMAND_ARGS[@]}"; do
    case "$arg" in
      --latest)
        target_count=$((target_count + 1))
        ;;
      --check)
        [[ "$HARNESS" == claude ]] || fail "--check is only valid for Claude Code"
        ;;
      --no-session)
        [[ "$HARNESS" == omp ]] || fail "--no-session is only valid for OMP"
        fail "OMP started with --no-session; native session data is unavailable, so usage cannot be reconstructed"
        ;;
      /*|*/*)
        [[ "$HARNESS" != opencode ]] ||
          fail "OpenCode usage accepts only a session ID or --latest"
        [[ "$HARNESS" != cursor ]] ||
          fail "Cursor usage accepts only a session ID or --latest"
        [[ -f "$arg" ]] || fail "session transcript does not exist: $arg"
        target_count=$((target_count + 1))
        ;;
      [A-Za-z0-9._]*)
        target_count=$((target_count + 1))
        ;;
      *) fail "invalid native usage target: $arg" ;;
    esac
  done
  ((target_count <= 1)) ||
    fail "usage accepts at most one session transcript target"
}
run_usage() {
  validate_usage_args
  local parser runner output_file error_file
  parser=""
  runner=""
  case "$HARNESS" in
    claude) parser="$PACKAGE_ROOT/adapters/claude/scripts/prompt_log_usage.sh"; runner=bash; require_command jq ;;
    codex|cursor) parser="$(source_for usage)"; runner=python3; require_command python3 ;;
    opencode) parser="$(source_for usage)"; runner=bash; require_command jq; require_command sqlite3 ;;
    omp) parser="$(source_for usage)"; runner=bun; require_command bun ;;
  esac
  [[ -f "$parser" ]] || fail "native usage parser is missing for $HARNESS"
  if ((${#COMMAND_ARGS[@]} == 0)); then COMMAND_ARGS=(--latest); fi
  output_file="$(mktemp "${TMPDIR:-/tmp}/session-log-usage.XXXXXX")"
  error_file="$(mktemp "${TMPDIR:-/tmp}/session-log-usage-error.XXXXXX")"
  printf '%s: usage\n' "$HARNESS_LABEL"
  set +e
  "$runner" "$parser" "${COMMAND_ARGS[@]}" >"$output_file" 2>"$error_file"
  local status=$?
  set -e
  if ((status != 0)); then
    local detail
    detail="$(cat "$error_file")"
    unlink "$output_file"
    unlink "$error_file"
    fail "native $HARNESS_LABEL usage failed${detail:+: $detail}"
  fi
  cat "$output_file"
  [[ -s "$output_file" ]] && printf '\n'
  unlink "$output_file"
  unlink "$error_file"
}

# Remove legacy leftovers and duplicate or stale session-log hook registrations under the
# install lock, then report what was removed (or that nothing was).
run_repair() {
  validate_state_dir
  preflight_install_lock
  acquire_install_lock
  trap release_install_lock EXIT
  legacy_cleanup
  repair_registrations
  release_install_lock
  trap - EXIT
  ((REPAIR_REPORTED)) ||
    printf '%s: repair found no duplicate or stale registrations\n' "$HARNESS_LABEL"
}

# The legacy cleanup `on` runs for a plugin-owned harness, best effort: a transient stop
# (INSTALL_LOCK_BUSY: another session-log command holds the install lock and runs the same cleanup, or
# settings.json changed under it) is reported as skipped, and a failure, taking the lock included, is
# reported once; neither fails `on`. `repair` repeats the cleanup and fails with the error.
run_best_effort_cleanup() {
  local error_file error status
  error_file="$(mktemp "${TMPDIR:-/tmp}/session-log-cleanup.XXXXXX")"
  # The lock and the cleanup run in an errexit subshell, so their first failing step ends only the
  # cleanup, and the subshell's EXIT trap releases the lock; the stdout report passes through while
  # stderr is captured. Nothing may wrap the subshell in `||`, `&&`, or `if`: bash would then ignore
  # errexit inside it.
  set +e
  (set -e; acquire_install_lock; trap release_install_lock EXIT; legacy_cleanup) 2>"$error_file"
  status=$?
  set -e
  error="$(awk 'NF { line = $0 } END { print line }' "$error_file")"
  error="${error#"$SESSION_LOG_LOG_PREFIX: "}"
  unlink "$error_file"
  if ((status == INSTALL_LOCK_BUSY)); then
    printf '%s: legacy cleanup skipped: %s\n' "$HARNESS_LABEL" "$error"
    return 0
  fi
  ((status != 0)) || return 0
  if [[ -n "$error" ]]; then
    printf '%s: legacy cleanup failed: %s; fix it, then run repair\n' "$HARNESS_LABEL" "$error"
  else
    printf '%s: legacy cleanup failed; run repair to see why\n' "$HARNESS_LABEL"
  fi
}

# `on` for a plugin-owned harness: best-effort legacy cleanup, then the enable flag. Without a
# current runtime marker, a flag this command created takes effect at the next prompt (in Cursor
# only once its plugin hooks run, which nothing here can see yet); a flag that was already on means
# the hooks of the running session never saw it, so they are not loaded.
# A missing load marker (runtime_marks_load) always means the extension is not loaded.
enable_plugin_hooks() {
  local was_enabled=0
  preflight_enable_flag
  validate_state_dir
  require_command jq
  run_best_effort_cleanup
  [[ ! -e "$FLAG_FILE" ]] || was_enabled=1
  set_enabled
  if runtime_current; then
    printf '%s: on\n' "$HARNESS_LABEL"
  elif ((was_enabled)) && [[ "$HARNESS" == cursor ]]; then
    printf '%s: %s\n' "$HARNESS_LABEL" "$CURSOR_HOOKS_NOT_LOADED"
  elif ((was_enabled)) || runtime_marks_load; then
    printf '%s: on — restart required\n' "$HARNESS_LABEL"
  elif [[ "$HARNESS" == cursor ]]; then
    printf '%s: %s\n' "$HARNESS_LABEL" "$CURSOR_ON_UNTIL_HOOKS_RUN"
  else
    printf '%s: on — logging starts with the next prompt\n' "$HARNESS_LABEL"
  fi
}

# `off` for a plugin-owned harness: it only removes the enable flag (and, but for OMP, the runtime
# markers), which needs no install lock: enable_flag.py locks the flag on its own. So it never waits
# for the `repair` a session start may be running under that lock: Claude Code's and Cursor's
# session-start hooks, the OpenCode plugin's setup, and the OMP extension's background repair.
disable_plugin_logging() {
  preflight_enable_flag
  validate_state_dir
  set_disabled
  printf '%s: off\n' "$HARNESS_LABEL"
}

main() {
  parse_args "$@"
  resolve_roots
  case "$COMMAND" in
    on)
      if plugin_owns_hooks; then
        enable_plugin_hooks
        return
      fi
      # Only Codex gets here: every other harness's plugin owns its hooks.
      require_codex_plugin_package
      # Legacy cleanup comes before the adapter preflight: it removes standalone adapter
      # copies of earlier releases that sit where the adapter goes.
      preflight_enable_flag
      preflight_state_files
      acquire_install_lock
      trap release_install_lock EXIT
      legacy_cleanup
      preflight_native_hooks
      repair_registrations
      if ! adapter_current; then install_adapter; fi
      set_enabled
      if runtime_current; then
        printf '%s: on\n' "$HARNESS_LABEL"
      else
        printf '%s: on — %s\n' "$HARNESS_LABEL" "$CODEX_TRUST_INSTRUCTION"
      fi
      release_install_lock
      trap - EXIT
      ;;
    off)
      if plugin_owns_hooks; then
        disable_plugin_logging
        return
      fi
      preflight_off
      acquire_install_lock
      trap release_install_lock EXIT
      set_disabled
      printf '%s: off\n' "$HARNESS_LABEL"
      release_install_lock
      trap - EXIT
      ;;
    status)
      plugin_owns_hooks || repair_enabled_adapter
      print_status
      ;;
    usage)
      plugin_owns_hooks || repair_enabled_adapter
      run_usage
      ;;
    repair)
      run_repair
      ;;
  esac
}

main "$@"
