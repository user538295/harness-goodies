{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/skills/session-log/hook\" cursor sessionStart",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/skills/session-log/hook\" cursor beforeSubmitPrompt",
        "timeout": 30
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/skills/session-log/hook\" cursor afterAgentResponse",
        "timeout": 30
      }
    ],
    "subagentStop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/skills/session-log/hook\" cursor subagentStop",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/skills/session-log/hook\" cursor stop",
        "timeout": 30
      }
    ]
  }
}
